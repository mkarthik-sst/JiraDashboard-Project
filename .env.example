# =====================================================================================
#  smartShift Defect Hub - configuration. Copy to .env.local (never commit it).
# =====================================================================================

# ---- Jira Cloud (leave JIRA_BASE_URL empty => safe MOCK mode, no real tickets) ----
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=mkarthik@smartshift.com
JIRA_API_TOKEN=
# Display path of the target workspace and the default Jira space key (used when the sheet's "Project key" is empty)
JIRA_WORKSPACE_PATH=Spaces / CS Clean Core / R&D
JIRA_DEFAULT_PROJECT_KEY=JAIT
# Optional: map a sheet "Project key" to a different real key (JSON). Normally empty - the sheet key is used as-is.
JIRA_PROJECT_MAP={}
# Optional: e-mail/name -> Jira accountId, for users whose e-mail is private in Jira, e.g. {"a@x.com":"5b10ac8d82e05b22cc7d4ef5"}
JIRA_USER_MAP={}
# Optional: custom field id that stores "Project lead" (e.g. customfield_10042). Empty => written into the description header
JIRA_LEAD_FIELD=
# true (default): if Jira refuses an OPTIONAL field (priority / assignee / reporter) the ticket is still created without it
# and a warning is shown. false => fail the ticket instead.
JIRA_LENIENT_FIELDS=true
# Optional labels added to EVERY ticket (comma separated). Empty = no labels.
JIRA_DEFAULT_LABELS=
# Suggested values for the Excel drop-downs (warning-style: other values are still accepted)
JIRA_ISSUE_TYPES=Bug,Task,Story,Epic
JIRA_PRIORITIES=Highest,High,High Attention,Medium,Low,Lowest
# Mock-mode chaos testing: 0..1 probability a simulated Jira call fails
JIRA_MOCK_FAIL_RATE=0

# ---- Deduplication ----
DEDUP_THRESHOLD=0.9

# ---- Local storage (working copy; Google Drive is the durable store when SYNC_MODE=gdrive) ----
DATA_DIR=./data
# false => brand-new store starts empty (use for real work). true => demo data (only for a look-around)
SEED_DEMO_DATA=false

# ---- Attachments: relative paths in the AttachmentPaths column resolve under this folder ----
ATTACHMENT_ROOT=.

# ---- Sync / storage: none | gdrive | folder | webhook ----
SYNC_MODE=none

# ======================= Google Drive storage (SYNC_MODE=gdrive) =======================
# Everything is saved in ONE shared Drive folder: uploads/, attachments/, tracking/ (a live workbook per upload), master/ and state/.
# 1) Folder: create it in Google Drive, open it, copy the id (the last part of the URL: drive.google.com/drive/folders/<ID>).
GDRIVE_FOLDER_ID=
# 2) Sign-in - choose ONE of the two:
#    A) SERVICE ACCOUNT (best for a Shared Drive / Workspace): Google Cloud Console > IAM > Service accounts > Keys > Add key > JSON.
#       Put the file next to the app (e.g. ./secrets/drive-key.json) and share the Drive folder with the account's e-mail
#       (...@...iam.gserviceaccount.com) as Editor (Content manager on a Shared Drive).
GDRIVE_KEY_FILE=./secrets/drive-key.json
#       On a host without files you can paste the whole JSON (or its base64) instead:  GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_SERVICE_ACCOUNT_JSON=
#    B) YOUR OWN GOOGLE ACCOUNT (works with an ordinary "My Drive" shared folder): OAuth client + refresh token (see docs/09-GOOGLE-DRIVE-SETUP.md)
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=
# true (default): a brand-new machine / new hosting instance with an empty data folder restores the dashboard from state/store.json in the folder
GDRIVE_RESTORE_ON_EMPTY=true
# Test only (scripts/drive-emulator.mjs): GDRIVE_API_URL, GDRIVE_UPLOAD_URL, GDRIVE_TOKEN_URL

# folder = master workbook on an SMB / UNC / mapped drive
SYNC_FOLDER_PATH=
# webhook = Power Automate HTTP trigger
POWER_AUTOMATE_URL=
POWER_AUTOMATE_SECRET=
POWER_AUTOMATE_INCLUDE_ROWS=false

# ---- E-mail notifications (SMTP). Empty SMTP_HOST = e-mail OFF (workflow still works) ----
# Office 365:  host smtp.office365.com, port 587, SMTP_SECURE=false (STARTTLS). The mailbox needs "Authenticated SMTP" enabled and,
#              with MFA, an app password. Gmail: smtp.gmail.com / 587 / app password. Internal relay: host + port, no user/password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=smartShift Defect Hub <mkarthik@smartshift.com>
# Public address of THIS dashboard - used for the links inside the e-mails. localhost only works on the same PC;
# for a team use the server name, e.g. https://defecthub.smartshift.com or http://pc-name:3000
APP_BASE_URL=http://localhost:3000
# Which events send mail (all true by default)
NOTIFY_ON_UPLOAD=true
NOTIFY_ON_REASSIGN=true
NOTIFY_ON_APPROVE=true
# Assignee / reporter written as a NAME in the sheet need an address: {"Display Name":"e-mail"} (Jira's own e-mail is used if visible)
NOTIFY_USER_MAP={}
# Receives the mail when no address can be found for a name (so nothing is silently lost). Empty = log a warning only
NOTIFY_FALLBACK_EMAIL=
# Optional copy on every mail (comma separated)
NOTIFY_CC=
# TEST MODE: really deliver every mail to this address (e.g. yourname@yopmail.com); the dashboard still shows the real recipient.
# One address, or JSON per person: {"mkarthik@smartshift.com":"karthik-hub@yopmail.com","*":"hub-test@yopmail.com"}. Empty = off (production)
NOTIFY_REDIRECT_TO=
# LOCAL TEST MAILBOX: with SMTP_HOST=127.0.0.1 the Hub starts its own mail catcher when it launches (no second window).
# Mails are saved in ./mail-sink and listed at http://localhost:3000/api/mail-sink. Nothing reaches real inboxes.
# SMTP_BUILTIN_SINK=false turns the built-in catcher off; MAIL_SINK_DIR changes the folder.
SMTP_BUILTIN_SINK=true
MAIL_SINK_DIR=./mail-sink
SMTP_IGNORE_TLS=false

# ---- Teams/Slack-compatible incoming webhook (optional, receives the same text) ----
NOTIFY_WEBHOOK_URL=


# ---- Reporter-review mail (v2.3) ---------------------------------------
NOTIFY_ON_REVIEW=true

# ---- Port (shared URL / hosting) ----------------------------------------
# PORT=3000

# ---- Sign-in for many users (v2.3) --------------------------------------
# AUTH_MODE=none            -> no sign-in (local testing)
# AUTH_MODE=email           -> e-mail magic-link sign-in; needs working SMTP + APP_BASE_URL
AUTH_MODE=none
# Long random text, 32+ characters. Never share it.
AUTH_SECRET=
# Admins: Sync now, Jira check, Open Drive folder
ADMIN_EMAILS=mkarthik@smartshift.com
# Who may sign in: whole domains and/or individual e-mails (comma separated)
AUTH_ALLOWED_DOMAINS=smartshift.com
AUTH_ALLOWED_EMAILS=
AUTH_SESSION_HOURS=12
AUTH_LINK_MINUTES=15
# true = only the assignee/reporter of a record (or an admin) may act on it
AUTH_ENFORCE_OWNER=false
# Who sees the "Open Drive folder" link and the "Drive copy" file links. Default = admins only. * = everybody
OPEN_DRIVE_USERS=mkarthik@smartshift.com

# ---- Engineering feedback for automated-fix defects (v2.4) ----------------
# A defect with "Automated fix issue = Yes" in the Excel sheet is an automated-fix issue.
# Which defects must have the details filled in BEFORE they can be approved:
#   flagged (default) = only automated-fix issues | all = every defect | off = never
ENGINEERING_REQUIRE_MODE=flagged
# Template columns that are mandatory (comma separated; choose from: Fix / Rule ID, Root cause, Impact, Prerequisites, Dependent data sources)
ENGINEERING_REQUIRED_FIELDS=Fix / Rule ID,Root cause,Impact,Prerequisites,Dependent data sources
# Jira space that receives automated-fix defects. Empty = the sheet's own Project key.
ENGINEERING_JIRA_PROJECT_KEY=
# Labels added to those tickets (comma separated) and an optional Jira component (must exist in that space)
ENGINEERING_JIRA_LABELS=automated-fix-feedback,product-engineering
ENGINEERING_JIRA_COMPONENT=
# Product-engineering mailbox (or several, comma separated) that gets a hand-over e-mail when an automated-fix defect is approved. Empty = no mail
ENGINEERING_NOTIFY_EMAIL=

# ---- Sample file (the "Sample data" download) ------------------------------
# Who the sample defects are assigned to / reported by. Set your own address to receive the demo e-mails.
SAMPLE_ASSIGNEE_EMAIL=alex.morgan@acme-demo.com
SAMPLE_REPORTER_EMAIL=sam.lee@acme-demo.com
# SAMPLE_PROJECT_KEY=JAIT
