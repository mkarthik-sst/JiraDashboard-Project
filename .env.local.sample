# >>> IMPORTANT: the Hub reads ONLY a file named exactly ".env.local" (in the same folder as package.json).
# >>> Copy this file, name the copy ".env.local" (Windows: in File Explorer enable "File name extensions" so it does not become ".env.local.txt"),
# >>> fill in your values and RESTART the Hub. A file called ".env.local.sample" is never read.
# =====================================================================================
#  smartShift Defect Hub v2.4.0 - SAMPLE .env.local  (all values below are EXAMPLES)
#  Copy this file to ".env.local", replace the values marked  <<< CHANGE ME, delete what you do not use.
#  Never commit .env.local, never e-mail it, never paste tokens into chat.
# =====================================================================================

# ---------- 1. Google Drive shared folder (replaces GitHub) ----------
SYNC_MODE=gdrive
# <<< CHANGE ME  last part of  https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz
GDRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Sign-in option A - service account (use with a Shared Drive).  <<< CHANGE ME
GDRIVE_KEY_FILE=./secrets/drive-key.json
# Sign-in option B - your own Google account (use with a normal My Drive folder). Leave A empty if you use B.
# GDRIVE_OAUTH_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# GDRIVE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# GDRIVE_OAUTH_REFRESH_TOKEN=1//0gxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GDRIVE_RESTORE_ON_EMPTY=true
# Who sees "Open Drive folder" (comma separated e-mails, * = everybody)
OPEN_DRIVE_USERS=*

# ---------- 2. Jira ----------
# Empty JIRA_BASE_URL = safe MOCK mode (no real tickets). Fill all three for real tickets.
JIRA_BASE_URL=https://smartshift-demo.atlassian.net
JIRA_EMAIL=mkarthik@smartshift.com
JIRA_API_TOKEN=<<< paste a NEW token (rotate the old one)
JIRA_DEFAULT_PROJECT_KEY=JAIT
JIRA_WORKSPACE_PATH=Spaces / CS Clean Core / R&D

# ---------- 3. Engineering feedback (customer feedback, v2.4) ----------
# flagged = mandatory details only for "Automated fix issue = Yes";  all = every defect;  off = never
ENGINEERING_REQUIRE_MODE=flagged
ENGINEERING_REQUIRED_FIELDS=Fix / Rule ID,Root cause,Impact,Prerequisites,Dependent data sources
# Product-engineering Jira space for automated-fix defects (must exist; empty = use the sheet's project key)
ENGINEERING_JIRA_PROJECT_KEY=PENG
ENGINEERING_JIRA_LABELS=automated-fix-feedback,product-engineering
# Optional Jira component that exists in that space
ENGINEERING_JIRA_COMPONENT=
# Hand-over mail when such a defect is approved (comma separated)
# Use a REAL mailbox/distribution list, or leave empty (empty = no hand-over mail). A made-up address will bounce.
ENGINEERING_NOTIFY_EMAIL=

# ---------- 4. E-mail (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mkarthik@smartshift.com
SMTP_PASSWORD=<<< Google app password (16 characters, no spaces)
SMTP_FROM=smartShift Defect Hub <mkarthik@smartshift.com>
# Link used inside e-mails. Local PC: http://localhost:3000   Hosted: https://your-hub-url
APP_BASE_URL=http://localhost:3000
NOTIFY_FALLBACK_EMAIL=mkarthik@smartshift.com

# ---------- 5. Sign-in (only when several people use the Hub) ----------
AUTH_MODE=none
# AUTH_MODE=email
# AUTH_SECRET=<<< 32+ random characters, e.g. output of: openssl rand -hex 32
ADMIN_EMAILS=mkarthik@smartshift.com
AUTH_ALLOWED_DOMAINS=smartshift.com

# ---------- 6. Basics ----------
DATA_DIR=./data
SEED_DEMO_DATA=false
DEDUP_THRESHOLD=0.9
# Addresses used by the "Sample data" download (put your own to receive the demo mails)
SAMPLE_ASSIGNEE_EMAIL=mkarthik@smartshift.com
SAMPLE_REPORTER_EMAIL=mkarthik@smartshift.com
